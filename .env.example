# ============================================================================
# ตัวอย่าง .env สำหรับ docker-compose.chatgpt.yml (OpenAI Secure MCP Tunnel)
# คัดลอกไฟล์นี้เป็น .env แล้วแก้ค่าตามจริง
#   cp .env.example .env
# ============================================================================

GOOGLE_API_KEY=<your_google_api_key>
ANTHROPIC_API_KEY=<your_key>

# --- OpenAI Secure MCP Tunnel ---
# สร้างได้ที่:
#   - tunnel ID:  https://platform.openai.com/settings/organization/tunnels
#   - API key:    https://platform.openai.com/settings/organization/api-keys
#     (ต้องมีสิทธิ Tunnels Read + Use)

# Runtime API key ของ tunnel-client (sk-...)
CONTROL_PLANE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Tunnel ID (tunnel_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx)
CONTROL_PLANE_TUNNEL_ID=tunnel_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Serena workspace ---

# โฟลเดอร์ workspace ที่จะให้ Serena เข้าถึง (mount เข้า /workspace ใน container)
# ค่าเริ่มต้น: /home/sun/projects (ทุกโปรเจกต์)
# เปลี่ยนเป็นโฟลเดอร์เฉพาะถ้าต้องการจำกัด เช่น /home/sun/projects/serena
WORKSPACE_DIR=/home/sun/projects
